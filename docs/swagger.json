{
    "swagger": "2.0",
    "info": {
        "description": "REST API for managing security rules, assets, and SECURITY_EXCEPTION rows.",
        "title": "Security Rules API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/de/securities/rules",
    "paths": {
        "/v1/api/events": {
            "get": {
                "description": "Inserts one or more SECURITY_EXCEPTION rows. Accepts an array of SecurityException objects.\nLong-lived text/event-stream that pushes events such as security_exception.inserted to subscribed clients.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json",
                    "text/event-stream"
                ],
                "tags": [
                    "security-exceptions",
                    "events"
                ],
                "summary": "Server-Sent Events stream of domain changes",
                "parameters": [
                    {
                        "description": "Security exceptions to insert",
                        "name": "exceptions",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.SecurityException"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "stream of SSE-formatted events",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "201": {
                        "description": "Created"
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "failed to insert security exceptions",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/api/getAssets": {
            "get": {
                "description": "Returns the deduplicated set of assets along with their latest exception metadata.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "assets"
                ],
                "summary": "List assets with exception summary",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Asset"
                            }
                        }
                    },
                    "500": {
                        "description": "failed to query assets",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/api/getSecurityExceptions": {
            "get": {
                "description": "Returns all SECURITY_EXCEPTION rows for the given Aladdin asset ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "security-exceptions"
                ],
                "summary": "List security exceptions for an asset",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Aladdin asset ID",
                        "name": "aladdin_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.SecurityException"
                            }
                        }
                    },
                    "400": {
                        "description": "aladdin_id query parameter is required",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "failed to query security exceptions",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/api/info": {
            "get": {
                "description": "Returns a static welcome string used as a basic liveness check.",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "info"
                ],
                "summary": "Service welcome message",
                "responses": {
                    "200": {
                        "description": "Welcome to Go microservices using Fiber",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/api/insertSecurityExceptions": {
            "post": {
                "description": "Inserts one or more SECURITY_EXCEPTION rows. Accepts an array of SecurityException objects.\nLong-lived text/event-stream that pushes events such as security_exception.inserted to subscribed clients.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json",
                    "text/event-stream"
                ],
                "tags": [
                    "security-exceptions",
                    "events"
                ],
                "summary": "Server-Sent Events stream of domain changes",
                "parameters": [
                    {
                        "description": "Security exceptions to insert",
                        "name": "exceptions",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.SecurityException"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "stream of SSE-formatted events",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "201": {
                        "description": "Created"
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "failed to insert security exceptions",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
