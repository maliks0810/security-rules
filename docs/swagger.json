                "asset_id": {
                    "type": "string"
                },
                "assign_to": {
                    "type": "string"
                },
                "bbg_last_refresh": {
                    "type": "string"
                },
                "exception_count": {
                    "type": "integer"
                },
                "exception_date": {
                    "type": "string"
                },
                "figi": {
                    "type": "string"
                },
                "priority": {
                    "type": "string"
                },
                "security_description": {
                    "type": "string"
                },
                "trader": {
                    "type": "string"
                },
                "trading_team": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
