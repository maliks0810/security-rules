        "/v1/api/getRules": {
            "get": {
                "description": "Returns rules from LIST_RULES, optionally filtered by process type.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rules"
                ],
                "summary": "List rules",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Process type filter",
                        "name": "process_type",
