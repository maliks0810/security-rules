                },
                "assign_to_date": {
                    "type": "string"
                },
                "assigned_by": {
                    "type": "string"
                },
                "category_type_id": {
                    "type": "integer"
                },
                "created_by": {
                    "type": "string"
                },
                "created_date": {
                    "type": "string"
                },
                "exception_source_id": {
                    "type": "integer"
                },
                "exception_status_id": {
